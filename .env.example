# ==============================================================================
# Vyora Environment Variables Template
#
# This file serves as the documented structure for required and optional
# environment variables.
# 
# NEVER commit actual secrets, API keys, or production database URIs here.
# Copy this file to `.env` or `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# [ServerEnvSchema] - Backend / Electron Main Process Only
# ------------------------------------------------------------------------------
# These variables must NEVER be bundled into the UI renderer or Next.js Client.

# Node environment (development, test, production)
NODE_ENV=development

# Database connection string (for Prisma)
# Example: file:./dev.db
# DATABASE_URL=

# ------------------------------------------------------------------------------
# [ClientEnvSchema] - Renderer / Browser Safe
# ------------------------------------------------------------------------------
# Variables safe to expose to the frontend.

# Base API URL for Next.js / Electron IPC context
# NEXT_PUBLIC_API_URL=http://localhost:3000
