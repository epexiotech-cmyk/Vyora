{
  "extends": "@vyora/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "paths": {
      "@prisma/client/sqlite": ["./node_modules/@prisma/client/sqlite"],
      "@prisma/client/postgres": ["./node_modules/@prisma/client/postgres"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
