{
  "name": "@vyora/desktop",
  "version": "1.0.0",
  "description": "Vyora ERP",
  "author": "Epexio Tech",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "rebuild": "electron-rebuild -f -w \"better-sqlite3,better-sqlite3-multiple-ciphers,keytar,argon2\"",
    "postinstall": "pnpm run rebuild",
    "dev": "concurrently -k \"pnpm run dev:renderer\" \"pnpm run dev:electron\"",
    "dev:renderer": "node ../../scripts/start-renderer.js",
    "dev:electron": "node ../../scripts/wait-renderer.js && pnpm exec tsup --watch --onSuccess \"cross-env NODE_ENV=development electron .\"",
    "build": "pnpm run build:renderer && pnpm run build:electron && pnpm exec electron-builder",
    "build:renderer": "cd renderer && pnpm run build",
    "build:electron": "pnpm exec tsup",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "pnpm exec tsc --noEmit -p electron/tsconfig.json && cd renderer && pnpm typecheck",
    "test:sales": "pnpm run build:electron && cross-env NODE_ENV=development RUN_SALES_TEST=true electron .",
    "test_propagate": "cross-env PORT=%RENDERER_PORT% node -e console.log(process.env.PORT)"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.2.13",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.0.0",
    "@vyora/config": "workspace:*",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "renderer": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@phc/format": "^1.0.0",
    "@vyora/database": "workspace:*",
    "@vyora/print-engine": "workspace:*",
    "@vyora/types": "workspace:*",
    "@vyora/utils": "workspace:*",
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.1.2",
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "bindings": "^1.5.0",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "file-uri-to-path": "1.0.0",
    "keytar": "^7.9.0",
    "node-gyp-build": "^4.8.4"
  }
}
