{
  "name": "vyora-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.js",
    "dev:clean": "pnpm run kill && pnpm run dev",
    "kill": "pnpm run kill:electron && pnpm run kill:renderer",
    "kill:electron": "node scripts/kill-electron.js",
    "kill:renderer": "node scripts/kill-renderer.js",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json}\"",
    "typecheck": "turbo run typecheck",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "better-sqlite3": "^11.1.2",
    "drizzle-orm": "^0.45.2",
    "electron": "^29.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "latest",
    "eslint-plugin-import": "latest",
    "eslint-plugin-prettier": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "latest",
    "typescript": "latest"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3",
      "bcrypt"
    ]
  }
}
